+def parse_rulesetdir(savegame_content: str) -> str:
+    """Return ``[game] rulesetdir`` (e.g. ``"classic"``), or ``''``."""
+    match = re.search(r'^rulesetdir="?([^"\n]*)"?$', savegame_content, re.MULTILINE)
