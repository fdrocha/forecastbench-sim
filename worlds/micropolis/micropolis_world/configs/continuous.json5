// Default parameters for the continuous eval
{
  // RNG seed for the simulations. Override per-run with --seed.
  "seed": 42,

  // Names the output directory under data/micropolis/continuous/. Defaults to
  // this file's own name when absent. Override per-run with --label.
  "label": "default",

  // Cities to run. Names come from module_globals.CITY_CHOICES.
  "cities": [
    "bruce",
    "haight",
    "freds",
    "happisle",
    "joffburg",
    "kamakura",
    "kowloon",
    "linecity",
    "senri",
    "southpac",
    "wetcity",
    "yokohama",
    "kobe",
    "kyoto",
    "deadwood",

    // The following cities start with 0 population and nothing happens
    // "about",
    // "finnigan",
    // "bluebird",
    // "splats",
    // "neatmap",
  ],

  // Disaster settings to run each city under; crossed with "cities".
  // [false, true] runs both variants of every city.
  "disasters": [true],

  // How many turns run_sim.py simulates. The corpus scripts ignore this and
  // derive their own length from snapshot_turns + horizons.
  "turns": 2400,

  // Turns at which a world report is generated and questions are asked,
  // and the forecast horizons past each snapshot. 48 turns per year.
  "snapshot_turns": [960, 1440],    // years 20 and 30
  "horizons": [144, 240, 336, 480], // 3, 5, 7 and 10 years
  "preamble_path" : "preamble2b.txt",

  "question_tagging": "numeric",

  // analyze_continuous.py --norm local / --norm baseline divide each question
  // by a number the continuations supply, which is 0 where a metric provably
  // could not move. Both floor that denominator at this share of the metric's
  // global scale; the report says how many questions the floor bound.
  // Override per run with --norm-global-frac.
  "norm_global_frac": 0.01,

  // Ask every horizon for one metric before moving to the next metric, so a
  // metric's whole trajectory is asked about in one run of consecutive lines.
  "questions_sort": "metric",

  // gen_report.py: turn to print the report for (negative counts back from the
  // last logged turn), and how often the report includes historical data.
  "snapshot_only_report" : false,
  "report_turn": -1,
  "history_freq": 24,
  "report_effectiveness": false,

  // Drop the city's money from the eval entirely: the city funds reading,
  // cash flow and auto-budget lines in CURRENT STATE, the city funds column
  // in HISTORY, and the city funds question itself. True is the default, so a
  // config that wants the balance reported and asked about must say false.
  "censorCityFunds": true,

  "models": "models-jaeho.json5",

  // Reseeded continuations per (city, snapshot) that extract_ground_truth.py
  // runs to estimate each question's P(Yes) and each metric's distribution.
  "branch_nseeds": 1000,
}
