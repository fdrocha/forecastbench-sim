// Prompt variant 'semlonger' of the continuous eval. semantic at later snapshots, history every 24 turns.
// Everything else is configs/continuous.json5: 15 cities with disasters on, the
// 24 models of models-loeff.json5, horizons of 3, 5, 7 and 10 years, city funds
// censored, so each model answers 30 prompts of 20 questions (smallbatch: 5 per snapshot).
{
  "seed": 42,
  "cities": ["bruce", "haight", "freds", "happisle", "joffburg", "kamakura", "kowloon", "linecity", "senri", "southpac", "wetcity", "yokohama", "kobe", "kyoto", "deadwood"],
  "disasters": [true],
  "turns": 2400,
  "snapshot_turns": [1440, 1920], // years 30 and 40
  "horizons": [144, 240, 336, 480], // 3, 5, 7 and 10 years
  "norm_global_frac": 0.01,
  "report_turn": -1,
  "censorCityFunds": true,
  "branch_nseeds": 1000,
  "questions_per_prompt": 50,

  // What this variant changes
  "preamble_path": "preamble2b.txt",
  "history_freq": 24,
  "question_tagging": "semantic",
  "questions_sort": "metric",

  "models": "../models-loeff.json5",
}
